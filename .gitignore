## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio / IDE
.vs/
.vscode/
.idea/
.omnisharp/
omnisharp.json
*.DotSettings
*.DotSettings.user

# Cursor / local agent
.cursor/
!.cursor/rules/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# MSTest / test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
TestResults/

# NCrunch / ReSharper / coverage
_NCrunch_*
.*crunch*.local.xml
_ReSharper*/
*.[Rr]e[Ss]harper
*.dotCover
coverage*.json
coverage*.xml
coverage/
.sonar/
.coverage/

# NuGet
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Publish
publish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj

# DocFX intermediate output (built site is committed under docs/ like TWP)
_site/
.github/obj/

# Others
*.cache
!*.[Cc]ache/
~$*
*~
*.log
*.pdb
*.ilk
node_modules/
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
